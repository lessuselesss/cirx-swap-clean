# Supabase PostgreSQL Configuration
# This replaces SQLite with a cloud-hosted PostgreSQL database

# Application Settings
APP_NAME=CIRX_OTC
APP_ENV=production
APP_DEBUG=false
APP_URL=https://circularprotocol.io/buy
APP_TIMEZONE=UTC

# Database Configuration - Supabase PostgreSQL
DB_CONNECTION=pgsql

# Option 1: Use DATABASE_URL (recommended)
# Get this from your Supabase project dashboard
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Option 2: Use individual variables (if DATABASE_URL not set)
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxx
# DB_PASSWORD=YOUR_PASSWORD
# DB_SCHEMA=public
# DB_SSLMODE=require

# For direct connection (bypassing pooler) - use port 5432
# DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Admin Settings
ADMIN_TOKEN_REQUIRED=true
ADMIN_TOKEN=your_secure_admin_token_here

# Ethereum/Sepolia Configuration
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_CHAIN_ID=11155111
ETHEREUM_NETWORK=sepolia
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Circular Protocol Settings
CIRX_NAG_URL=https://nag.circularlabs.io/NAG.php?cep=
CIRX_WALLET_PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY
CIRX_WALLET_ADDRESS=YOUR_WALLET_ADDRESS
CIRX_DECIMALS=18
TESTNET_MODE=true

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://circularprotocol.io,https://*.pages.dev
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

# Worker Settings
WORKER_BATCH_SIZE=10
WORKER_PROCESS_INTERVAL=30
WORKER_API_KEY=worker_secret_key

# Logging
LOG_LEVEL=info
LOG_CHANNEL=daily
LOG_FILE_PATH=/tmp/cirx-otc/backend.log
LOG_MAX_FILES=7
API_LOGGING_ENABLED=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Platform Settings
PLATFORM_FEE_WALLET=0x834244d016f29d6acb42c1b054a88e2e9b1c9228

# Feature Flags
FEATURE_BATCH_TRANSFERS=false
FEATURE_AUTOMATIC_RETRIES=true
FEATURE_SLACK_NOTIFICATIONS=false
FEATURE_ADVANCED_MONITORING=false

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CIRX_BALANCE_ALERT_THRESHOLD=50

# Iroh Bridge (optional)
IROH_ENABLED=false
IROH_BRIDGE_URL=http://localhost:9090